
# load cell score
results_geo <- read.csv('./results_geo.csv',header = T,row.names = 1)  %>% scale(center = F) %>% as.data.frame() %>% select(c(1:40))
# Combine with clinical metadata
meta1 <- cbind(meta,results_geo)

meta1$TNM <- factor(meta1$TNM)
meta2 <- subset(meta1, time.OS.months.<=120 & TNM != 'NA')
ggplot(meta2,aes(x=TNM,y=meta2$Fibro.GJA4))+
  geom_boxplot(color='black',size=0.5)+
  stat_compare_means(method = "t.test",  label = "p.signif",ref.group = '1')
ggbarplot(meta2,
          x = "TNM", y = "CD8T.CXCL13",
          add = "mean_se",  fill = 'TNM',    
          palette = c('#ADCCE0','#3C76AE','#CF352B','#8B1A18'),   
          ylab = "Enrich score") +
  stat_compare_means(method = "t.test", label = "p.format",
                     comparisons = list(c("1", "2"),c("1", "3"),c("1", "4"))) 



# cms 
# Compute the median value
meta2 <- subset(meta1, prediction!= 'NA')
data <- meta2[,c(36:76)]
result_cms <- data %>%
  group_by(prediction) %>%
  summarise(across(everything(), median, na.rm = TRUE)) %>% as.data.frame()
rownames(result_cms)<- result_cms$prediction
result_cms<- result_cms[,-c(1,17)]
result_cms <- result_cms[, colSums(result_cms)!= 0]
pheatmap(result_cms,cluster_rows = F)

# mmr status
meta2 <- subset(meta1, mmr_status!= 'NA')
data <- meta2[,c(20,37:76)]
result_mmr <- data %>%
  group_by(mmr_status) %>%
  summarise(across(everything(), median, na.rm = TRUE)) %>% as.data.frame()
rownames(result_mmr)<- result_mmr$mmr_status
result_mmr<- result_mmr[,-c(1,17)]
result_mmr <- result_mmr[, colSums(result_mmr)!= 0]
pheatmap(result_mmr,cluster_rows = F)


      
      
      
      
