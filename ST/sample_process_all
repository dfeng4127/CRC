# integrate all ST
integ <- list(ST2=st2,ST3=st3,ST5=st5,ST9=st9,ST10=st10,ST11=st11,ST12=st12,ST13=st13)


#  standard normalization and variable feature selection
integ <- lapply(X = integ, FUN = function(x) {
  x <- NormalizeData(x, verbose = FALSE,scale.factor = 100000)
  x <- FindVariableFeatures(x, verbose = FALSE)
})

features <- SelectIntegrationFeatures(object.list = integ)
integ <- lapply(X = integ, FUN = function(x) {
  x <- ScaleData(x, features = features, verbose = FALSE)
  x <- RunPCA(x, features = features, verbose = FALSE)
})

# reference can be changed
anchors <- FindIntegrationAnchors(object.list = integ, reference = c(2, 7), reduction = "rpca",
                                  dims = 1:20)
sc_merge <- IntegrateData(anchorset = anchors, dims = 1:50)

sc_merge <- ScaleData(sc_merge, verbose = FALSE)
sc_merge <- RunPCA(sc_merge, verbose = FALSE)
sc_merge <- FindNeighbors(sc_merge, dims = 1:10)
sc_merge <- FindClusters(sc_merge, resolution = 0.5)
sc_merge <- RunUMAP(sc_merge, dims = 1:15)

# add information
Idents(sc_merge) <-'orig.ident'
new.cluster.ids <- c('IV','I','III','I','II','II','III','I')
names(new.cluster.ids) <- levels(sc_merge)
sc_merge <- RenameIdents(sc_merge, new.cluster.ids)
sc_merge$grade<- Idents(sc_merge)
sc_merge$grade <- factor(sc_merge$grade,levels = c('I','II','III','IV'))


# number counts 
count1 <- as.data.frame(table(sc_merge@meta.data[["orig.ident"]]))
colnames(count1) <- c('ID','cell_number')
pdf('./num.pdf',height = 2.5,width = 3.5)
ggplot(count1,aes(x=cell_number,y=ID,fill=ID))+geom_bar(stat = 'identity')+scale_y_discrete(limits=c('st13','st12','st11','st10','st9','st5','st3','st2'))+
  scale_fill_brewer(limits= c('st13','st12','st11','st10','st9','st5','st3','st2'),palette = 'Set1')+theme_test()
dev.off()


